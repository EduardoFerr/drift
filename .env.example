# Versão do app (sincroniza com package.json)
VITE_APP_VERSION=0.5.4

# Fase 6.1b: usa Nostr DM cifrado (NIP-44 kind 1059) pro signaling WebRTC.
# Default 'off' (= mock BroadcastChannel same-origin pra dev/PoC).
# '1' = Nostr — funciona entre redes diferentes via relays existentes.
VITE_USE_NOSTR_SIGNALING=

# Fase 6.3: TURN servers pra WebRTC funcionar em mobile real (4G CGN,
# symmetric NAT). STUN-only cobre ~70% das conexões; TURN cobre o resto
# via relay TCP. Default vazio (sem TURN) — TURN provider vê IP do user
# (manifesto §28 — privacidade pelo mínimo).
#
# Formato: comma-separated `turn:host:port` ou `turn:host:port?username=foo&credential=bar`
# Exemplo: VITE_TURN_SERVERS=turn:numb.viagenie.ca?username=user&credential=pass
#
# AVISO CRÍTICO: Vite EMBUTE env vars VITE_* no bundle JS público.
# Credentials TURN comerciais (Twilio, Cloudflare paid) NÃO devem ser
# hardcoded aqui — usar ephemeral creds via REST API runtime. Esta env
# é segura APENAS pra TURN gratuito com creds públicas (numb.viagenie.ca)
# ou self-hosted coturn aberto. Manifesto §28.
VITE_TURN_SERVERS=
