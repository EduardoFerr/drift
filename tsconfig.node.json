{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsbuildinfo",
    "declaration": true
  },
  "include": ["vite.config.ts", "playwright.config.ts"]
}
