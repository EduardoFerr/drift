{
  "name": "drift",
  "private": true,
  "version": "0.6.0-alpha.4",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "cross-env DRIFT_DEV_HTTP=1 vite",
    "build": "tsc -b && vite build && node scripts/strip-sourcemaps.mjs && node scripts/inject-sri.mjs && node scripts/inline-css.mjs && node scripts/preload-fonts.mjs",
    "lint": "tsc -b --noEmit",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-pwa-icons.mjs",
    "design:baseline:init": "node scripts/update-design-baseline.mjs --init",
    "design:baseline:check": "node scripts/update-design-baseline.mjs --check",
    "design:baseline:update": "node scripts/update-design-baseline.mjs",
    "design:codemod": "node scripts/codemod-slate-to-drift.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lhci": "lhci autorun",
    "test:bundle-size": "npm run build && vitest run tests/cwv-conformance.test.ts",
    "build:analyze": "cross-env DRIFT_ANALYZE=1 npm run build"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.3.1",
    "@fontsource-variable/syne": "^5.2.7",
    "@fontsource/dm-mono": "^5.2.7",
    "@helia/unixfs": "^7.2.1",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.0.0",
    "blockstore-idb": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "datastore-idb": "^4.0.3",
    "framer-motion": "^11.0.0",
    "helia": "^6.1.4",
    "maplibre-gl": "^5.24.0",
    "nostr-tools": "^2.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "workbox-window": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript-eslint/utils": "^8.59.2",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.5"
  }
}
