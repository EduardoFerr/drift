# syntax=docker/dockerfile:1.6
# Build reproduzivel do Drift — manifesto §17.
# Output: /artifacts/dist/        (PWA estatica)
#         /artifacts/tauri/        (Tauri Linux: .deb, .AppImage)
#
# SOURCE_DATE_EPOCH preserva timestamps deterministicos cross-build.
# Versoes pinned exatas (sem range) garantem mesmo bytecode.
# Locale C + TZ UTC eliminam locale-dependent ordering.

ARG NODE_VERSION=20.18.1
ARG RUST_VERSION=1.90.0
# Bump 1.83 → 1.90 (2026-05-01) — escalada de MSRV das deps transitivas
# do arti workspace + tauri-build:
#   1.83 → 1.85: edition2024 (serde_spanned 1.1+, toml 0.9+)
#   1.85 → 1.88: icu 2.2+, darling 0.23+
#   1.88 → 1.89: retry-error 0.12+, tor-error 0.41+
#   1.89 → 1.90: typed-index-collections 3.5+
# 1.90.0 cobre toda a cadeia conhecida em 2026-05-01. CI usa `stable`
# (sempre >= 1.90 hoje) pra detectar drift de API; este Dockerfile
# pina pra reprodutibilidade auditável.
ARG DEBIAN_VERSION=bookworm-slim
# Rust e node usam ordens distintas pro slim+distro no Docker Hub:
#   node:VERSION-bookworm-slim          (variant primeiro)
#   rust:VERSION-slim-bookworm          (slim primeiro)
#   debian:bookworm-slim                (variant primeiro)
# Por isso o tag rust eh montado com flip explicito em vez de
# reusar ${DEBIAN_VERSION}.
ARG RUST_DEBIAN_VARIANT=slim-bookworm
ARG SOURCE_DATE_EPOCH=1735689600
# Fixed reference epoch = 2025-01-01T00:00:00Z (Unix timestamp 1735689600).
# Escolha arbitrária mas estavel: usar uma data passada *fixa* faz com que
# qualquer auditor que rode este Dockerfile produza o mesmo binario,
# independente do dia em que esta auditando. Manifesto §17.
#
# Por que NAO `git log -1 --format=%ct`: timestamps de commit variam por
# rebase/cherry-pick mesmo sem mudar conteudo, quebrando reprodutibilidade
# entre branches que tem mesmo source. Fixo elimina esse vetor.
#
# Por que NAO o timestamp da tag de release: cada release teria seu epoch,
# entao re-build de release antiga pra audit precisaria adivinhar qual
# usar. Fixo significa "sempre o mesmo" sem coordenacao.
#
# Trade-off aceito: timestamps internos dos artifacts (manifest, sourcemap)
# todos congelam em 2025-01-01. Bug de telemetria de "release feito quando?"
# eh respondido pela tag git (`git tag`), nao pelo timestamp do binario.

# ─── Stage 1: Vite/PWA build ───────────────────────────────────────
FROM node:${NODE_VERSION}-${DEBIAN_VERSION} AS pwa-builder
# IMPORTANTE: NODE_ENV=production fica fora do ENV inicial — quando
# definido, npm install IGNORA devDependencies. Como `npm run build`
# (= tsc + vite build) precisa de TUDO em devDependencies (vite,
# @vitejs/plugin-react, @types/node, @types/qrcode, vite-plugin-pwa,
# typescript), setamos NODE_ENV apenas APÓS o build, pra runtime.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    npm_config_audit=false \
    npm_config_fund=false

WORKDIR /build
# Copy lockfiles primeiro pra cache otimizado
COPY package.json package-lock.json ./
# `npm install` em vez de `npm ci` pelo mesmo motivo do ci.yml:37-42 —
# bug conhecido do npm com entries "extraneous": true em binarios
# cross-platform do esbuild (vitest 4.x bundled esbuild 0.28 enquanto
# vite 5.x usa 0.21; npm ci recusa "Missing esbuild@0.28.0 from lock
# file"). Sacrifica determinismo perfeito de versões transitivas, mas
# package-lock.json esta versionado e as versões top-level continuam
# pinadas. Reprodutibilidade bit-identical do bundle final preservada
# desde que rodando o mesmo Dockerfile (mesma data de cache npm).
# `--include=dev` explicito por garantia (em alguns Node defaults isso
# muda baseado em outras envs).
RUN npm install --no-audit --no-fund --prefer-offline --include=dev

COPY tsconfig*.json vite.config.ts ./
# Tailwind + PostCSS configs sao runtime deps do build Vite — sem isso,
# CSS sai sem classes Tailwind processadas (silent failure).
COPY tailwind.config.* postcss.config.* ./
COPY index.html ./
COPY public/ public/
COPY src/ src/
COPY scripts/ scripts/

RUN npm run build
# Output: dist/

# ─── Stage 2: Tauri Linux build ──────────────────────────────────────
FROM rust:${RUST_VERSION}-${RUST_DEBIAN_VARIANT} AS tauri-builder
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    CARGO_NET_OFFLINE=false \
    CARGO_INCREMENTAL=0
# CARGO_INCREMENTAL=0 desliga incremental compilation (deterministico)

# Tauri deps de sistema (Debian bookworm)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    build-essential \
    curl \
    file \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Reusa output do PWA stage
COPY --from=pwa-builder /build/dist ./dist
COPY --from=pwa-builder /build/node_modules ./node_modules
COPY --from=pwa-builder /build/package.json ./package.json

COPY src-tauri/ src-tauri/
WORKDIR /build/src-tauri

# Build determinístico: `--locked` garante uso EXATO das versões pinadas
# em Cargo.lock (qualquer dessync com Cargo.toml falha o build).
# `--frozen` foi REMOVIDO — proibe rede E cargo cache no Docker está
# vazio na primeira execução, falhando com "no matching package named
# arti-client" (apesar do package estar no lock, source não está em
# cache local). Determinismo via `--locked` é suficiente — versões
# fixas; só permitir download é diferente de permitir resolution.
# Apenas `cargo build` (sem `tauri build` bundler) — produz binário
# standalone `target/release/drift`. Bundles .deb/.AppImage exigem
# `tauri build` que invoca scripts adicionais (cargo-bundle,
# debianização) e tem matriz de deps de sistema mais ampla — fica
# pra commit futuro quando smoke validar essa stage.
RUN cargo build --release --locked
RUN ls -la target/release/

# Stage intermediário: coleta artifacts num único filesystem antes do final.
# Usa shell pra fazer cópias condicionais (sintaxe `2>/dev/null || true` em
# COPY é inválida — Dockerfile interpreta como argumentos extras, falha hard).
FROM debian:${DEBIAN_VERSION} AS collector
WORKDIR /collect
COPY --from=pwa-builder /build/dist ./dist/
COPY --from=tauri-builder /build/src-tauri/target/release/drift ./tauri/drift-bin
# Gera checksums determinísticos com locale fixo (LC_ALL=C garante ordering
# byte-a-byte, sem dependência do locale do host). `-print0` + `sort -z`
# tolera filenames com espaço/newline; `xargs -0` mantém terminator NUL.
RUN LC_ALL=C find . -type f -print0 \
    | LC_ALL=C sort -z \
    | xargs -0 sha256sum > SHA256SUMS

# ─── Stage 3: Final artifacts ───────────────────────────────────────
FROM debian:${DEBIAN_VERSION} AS artifacts
WORKDIR /artifacts
COPY --from=collector /collect/ ./

CMD ["sh", "-c", "find /artifacts -type f -ls && cat /artifacts/SHA256SUMS"]
